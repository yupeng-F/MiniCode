# MiniCode 环境变量示例。复制为 .env 后填写真实值，禁止提交 .env。

# 对话模型
DEEPSEEK_API_KEY=your_deepseek_api_key_here
MINICODE_MODEL=deepseek-v4-flash

# 阿里云百炼 embedding；业务空间 ID 不包含区域和域名
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_WORKSPACE_ID=ws-your-workspace-id
DASHSCOPE_REGION=cn-beijing
# 可选：完整兼容地址会覆盖 WORKSPACE_ID/REGION 自动生成的地址
# DASHSCOPE_BASE_URL=https://ws-your-workspace-id.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
MINICODE_EMBEDDING_MODEL=qwen3.7-text-embedding
MINICODE_EMBEDDING_CACHE=.minicode/models
